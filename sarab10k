<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منيو مطعم نوح - طلبات الطاولات</title>
    <!-- استخدام Tailwind CSS للتصميم السريع والجميل -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');
        body { 
            font-family: 'Cairo', sans-serif; 
            background-color: #0f0f11;
            color: #f3f4f6;
        }
        /* تأثيرات الإضاءة التدرجية واللمعان الفاخر */
        .gold-gradient {
            background: linear-gradient(135deg, #d4af37 0%, #f3e5ab 50%, #aa771c 100%);
        }
        .gold-text {
            background: linear-gradient(135deg, #f3e5ab 0%, #d4af37 50%, #aa771c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-border {
            border-color: rgba(212, 175, 55, 0.3);
        }
        .glass-card {
            background: rgba(24, 24, 28, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }
    </style>
</head>
<body class="pb-24">

    <!-- شريط العنوان العلوي الداكن والفخم مع صورة اسم المطعم -->
    <header class="bg-zinc-950/90 border-b border-amber-500/20 p-4 sticky top-0 z-40 backdrop-blur-md flex justify-between items-center shadow-lg">
        <div class="flex items-center gap-3">
            <!-- صورة المطعم -->
            <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-amber-500/50 shadow-md shrink-0">
                <img src="1000004765.jpg" alt="مطعم نوح" class="w-full h-full object-cover">
            </div>
            <div>
                <h1 class="text-xl font-bold gold-text flex items-center gap-1.5">
                    مطعم نوح
                </h1>
                <p id="table-indicator" class="text-xs text-zinc-400 mt-0.5">جاري تحديد الطاولة...</p>
            </div>
        </div>
        <button onclick="toggleCart()" class="relative bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-zinc-950 px-3.5 py-2 rounded-xl text-sm font-bold transition shadow-md flex items-center gap-1">
            <i class="fa-solid fa-cart-shopping"></i> السلة
            <span id="cart-badge" class="absolute -top-2 -right-2 bg-red-600 text-white text-xs w-5 h-5 flex items-center justify-center rounded-full font-bold hidden shadow-lg">0</span>
        </button>
    </header>

    <!-- محتوى المنيو الرئيسي (شبكة بطاقات فخمة) -->
    <main class="max-w-4xl mx-auto p-4">
        <h2 class="text-lg font-bold mb-4 text-zinc-300 flex items-center gap-2 border-b border-zinc-800 pb-2">
            <i class="fa-solid fa-utensils text-amber-400"></i> قائمة الطعام الفاخرة
        </h2>
        
        <!-- شبكة القوالب (Grid) -->
        <div id="menu-items" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 gap-4">
            
            <!-- قالب الوجبة الأولى -->
            <div class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between hover:border-amber-500/50 transition duration-300 shadow-xl">
                <div>
                    <div class="h-28 sm:h-36 bg-zinc-800 overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&auto=format&fit=crop" alt="برجر لحم" class="w-full h-full object-cover opacity-90 hover:scale-105 transition duration-500">
                        <span class="absolute bottom-2 right-2 bg-zinc-950/80 border border-amber-500/40 gold-text text-xs font-bold px-2.5 py-1 rounded-lg backdrop-blur-sm">8,500 د.ع</span>
                    </div>
                    <div class="p-3">
                        <h3 class="font-bold text-zinc-100 text-sm sm:text-base">برجر لحم ديلوكس</h3>
                        <p class="text-zinc-400 text-[11px] sm:text-xs mt-1 line-clamp-2">لحم بقرى طازج مع الجبن والخضار الطازجة وصوص الخاص.</p>
                    </div>
                </div>
                <div class="p-3 pt-0 space-y-2.5">
                    <input type="text" placeholder="اكتب ما تحب إضافته أو إزالته..." class="w-full text-[11px] bg-zinc-900/90 text-zinc-200 placeholder-zinc-500 border border-zinc-800 rounded-lg p-2 focus:outline-none focus:border-amber-500/60" id="note-1">
                    
                    <!-- أزرار تحديد الكمية والإضافة -->
                    <div class="flex items-center justify-between bg-zinc-900 border border-zinc-800 rounded-xl p-1">
                        <div class="flex items-center gap-2 px-2">
                            <button onclick="changeQty('qty-1', -1)" class="text-zinc-400 hover:text-amber-400 font-bold px-1 text-sm"><i class="fa-solid fa-minus"></i></button>
                            <span id="qty-1" class="font-bold text-sm w-4 text-center text-amber-300">1</span>
                            <button onclick="changeQty('qty-1', 1)" class="text-zinc-400 hover:text-amber-400 font-bold px-1 text-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <button onclick="addToCart('برجر لحم ديلوكس', 8500, 'note-1', 'qty-1')" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-zinc-950 text-xs px-3.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 shadow">
                            إضافة
                        </button>
                    </div>
                </div>
            </div>

            <!-- قالب الوجبة الثانية -->
            <div class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between hover:border-amber-500/50 transition duration-300 shadow-xl">
                <div>
                    <div class="h-28 sm:h-36 bg-zinc-800 overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=400&auto=format&fit=crop" alt="بيتزا مارغريتا" class="w-full h-full object-cover opacity-90 hover:scale-105 transition duration-500">
                        <span class="absolute bottom-2 right-2 bg-zinc-950/80 border border-amber-500/40 gold-text text-xs font-bold px-2.5 py-1 rounded-lg backdrop-blur-sm">10,000 د.ع</span>
                    </div>
                    <div class="p-3">
                        <h3 class="font-bold text-zinc-100 text-sm sm:text-base">بيتزا مارغريتا</h3>
                        <p class="text-zinc-400 text-[11px] sm:text-xs mt-1 line-clamp-2">صلصة الطماطم الإيطالية وجبن الموزاريلا والريحان.</p>
                    </div>
                </div>
                <div class="p-3 pt-0 space-y-2.5">
                    <input type="text" placeholder="اكتب ما تحب إضافته أو إزالته..." class="w-full text-[11px] bg-zinc-900/90 text-zinc-200 placeholder-zinc-500 border border-zinc-800 rounded-lg p-2 focus:outline-none focus:border-amber-500/60" id="note-2">
                    
                    <div class="flex items-center justify-between bg-zinc-900 border border-zinc-800 rounded-xl p-1">
                        <div class="flex items-center gap-2 px-2">
                            <button onclick="changeQty('qty-2', -1)" class="text-zinc-400 hover:text-amber-400 font-bold px-1 text-sm"><i class="fa-solid fa-minus"></i></button>
                            <span id="qty-2" class="font-bold text-sm w-4 text-center text-amber-300">1</span>
                            <button onclick="changeQty('qty-2', 1)" class="text-zinc-400 hover:text-amber-400 font-bold px-1 text-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <button onclick="addToCart('بيتزا مارغريتا كلاسيك', 10000, 'note-2', 'qty-2')" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-zinc-950 text-xs px-3.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 shadow">
                            إضافة
                        </button>
                    </div>
                </div>
            </div>

            <!-- قالب الوجبة الثالثة -->
            <div class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between hover:border-amber-500/50 transition duration-300 shadow-xl">
                <div>
                    <div class="h-28 sm:h-36 bg-zinc-800 overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?w=400&auto=format&fit=crop" alt="عصير ليمون" class="w-full h-full object-cover opacity-90 hover:scale-105 transition duration-500">
                        <span class="absolute bottom-2 right-2 bg-zinc-950/80 border border-amber-500/40 gold-text text-xs font-bold px-2.5 py-1 rounded-lg backdrop-blur-sm">3,000 د.ع</span>
                    </div>
                    <div class="p-3">
                        <h3 class="font-bold text-zinc-100 text-sm sm:text-base">عصير ليمون بالنعناع</h3>
                        <p class="text-zinc-400 text-[11px] sm:text-xs mt-1 line-clamp-2">منعش وطازج محضر يومياً عند الطلب.</p>
                    </div>
                </div>
                <div class="p-3 pt-0 space-y-2.5">
                    <input type="text" placeholder="اكتب ما تحب إضافته أو إزالته..." class="w-full text-[11px] bg-zinc-900/90 text-zinc-200 placeholder-zinc-500 border border-zinc-800 rounded-lg p-2 focus:outline-none focus:border-amber-500/60" id="note-3">
                    
                    <div class="flex items-center justify-between bg-zinc-900 border border-zinc-800 rounded-xl p-1">
                        <div class="flex items-center gap-2 px-2">
                            <button onclick="changeQty('qty-3', -1)" class="text-zinc-400 hover:text-amber-400 font-bold px-1 text-sm"><i class="fa-solid fa-minus"></i></button>
                            <span id="qty-3" class="font-bold text-sm w-4 text-center text-amber-300">1</span>
                            <button onclick="changeQty('qty-3', 1)" class="text-zinc-400 hover:text-amber-400 font-bold px-1 text-sm"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <button onclick="addToCart('عصير ليمون بالنعناع', 3000, 'note-3', 'qty-3')" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-zinc-950 text-xs px-3.5 py-1.5 rounded-lg font-bold transition flex items-center gap-1 shadow">
                            إضافة
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- نافذة السلة العائمة بالأسفل (تصميم داكن فاخر) -->
    <div id="cart-modal" class="fixed inset-x-0 bottom-0 bg-zinc-950 border-t border-amber-500/30 p-5 rounded-t-3xl transform translate-y-full transition-transform duration-300 z-50 max-w-lg mx-auto shadow-2xl">
        <div class="flex justify-between items-center mb-3 border-b border-zinc-800 pb-2">
            <h3 class="font-bold text-zinc-100 text-base flex items-center gap-2">
                <i class="fa-solid fa-receipt text-amber-400"></i> ملخص الطلب
            </h3>
            <button onclick="toggleCart()" class="text-zinc-500 hover:text-zinc-300 text-sm"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        
        <div id="cart-items-list" class="max-h-48 overflow-y-auto space-y-2 mb-3 text-xs divide-y divide-zinc-900">
            <!-- يتم تعبئة العناصر هنا ديناميكياً -->
        </div>

        <div class="border-t border-zinc-800 pt-3 flex justify-between items-center font-bold text-sm mb-4">
            <span class="text-zinc-300">المجموع الكلي:</span>
            <span id="cart-total" class="gold-text text-lg font-bold">0 د.ع</span>
        </div>

        <button onclick="submitOrder()" class="w-full bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-500 hover:to-emerald-600 text-white py-3 rounded-xl font-bold text-sm shadow-lg transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane"></i> إرسال الطلب للكاشير
        </button>
    </div>

    <!-- رسالة النجاح المنبثقة -->
    <div id="success-alert" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden flex items-center justify-center z-50 p-4">
        <div class="bg-zinc-900 border border-amber-500/30 p-6 rounded-3xl max-w-xs text-center shadow-2xl">
            <div class="w-16 h-16 bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
                <i class="fa-solid fa-check"></i>
            </div>
            <h3 class="font-bold text-zinc-100 text-base mb-1">تم إرسال طلبك بنجاح!</h3>
            <p id="success-message" class="text-xs text-zinc-400 mb-5">تم إرسال الطلب إلى الكاشير وسيتم تمريره للويتر قريباً.</p>
            <button onclick="closeSuccess()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-zinc-950 text-xs px-5 py-2.5 rounded-xl font-bold w-full shadow">تم</button>
        </div>
    </div>

    <!-- كود الجافاسكريبت للتحكم التفاعلي -->
    <script>
        let cart = [];
        let tableNumber = "غير محددة";

        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            const table = urlParams.get('table');
            if (table) {
                tableNumber = table;
                document.getElementById('table-indicator').innerText = `أنت جالس على الطاولة رقم: ${tableNumber}`;
            } else {
                document.getElementById('table-indicator').innerText = `طاولة تجريبية (لم يتم تحديد رقم في الرابط)`;
            }
        };

        function changeQty(qtyElementId, change) {
            const qtyElement = document.getElementById(qtyElementId);
            let currentQty = parseInt(qtyElement.innerText);
            currentQty += change;
            if (currentQty < 1) currentQty = 1;
            qtyElement.innerText = currentQty;
        }

        function addToCart(name, price, noteInputId, qtyElementId) {
            const noteInput = document.getElementById(noteInputId);
            const note = noteInput.value.trim();
            const qty = parseInt(document.getElementById(qtyElementId).innerText);

            const existingIndex = cart.findIndex(item => item.name === name && item.note === note);
            if (existingIndex > -1) {
                cart[existingIndex].qty += qty;
            } else {
                cart.push({ name, price, note, qty });
            }

            updateCartUI();
            
            noteInput.value = '';
            document.getElementById(qtyElementId).innerText = '1';
            
            toggleCart(true);
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const itemsList = document.getElementById('cart-items-list');
            const totalElement = document.getElementById('cart-total');

            const totalItemsCount = cart.reduce((sum, item) => sum + item.qty, 0);
            if (totalItemsCount > 0) {
                badge.classList.remove('hidden');
                badge.innerText = totalItemsCount;
            } else {
                badge.classList.add('hidden');
            }

            let html = '';
            let total = 0;

            cart.forEach((item, index) => {
                let itemTotal = item.price * item.qty;
                total += itemTotal;
                html += `
                    <div class="pt-2 flex justify-between items-start">
                        <div>
                            <span class="font-bold text-zinc-200">${item.name} <span class="text-amber-400 font-semibold">(×${item.qty})</span></span>
                            ${item.note ? `<p class="text-amber-300/80 text-[10px] mt-0.5">التعديل المطلوب: ${item.note}</p>` : ''}
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-amber-400 font-semibold">${itemTotal.toLocaleString()} د.ع</span>
                            <button onclick="removeFromCart(${index})" class="text-red-400 hover:text-red-300"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                `;
            });

            if (cart.length === 0) {
                html = '<p class="text-center text-zinc-500 py-4">السلة فارغة حالياً</p>';
            }

            itemsList.innerHTML = html;
            totalElement.innerText = total.toLocaleString() + ' د.ع';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function toggleCart(forceOpen = false) {
            const modal = document.getElementById('cart-modal');
            if (forceOpen || modal.classList.contains('translate-y-full')) {
                if(cart.length === 0) {
                    alert('السلة فارغة، أضف بعض الوجبات أولاً.');
                    return;
                }
                modal.classList.remove('translate-y-full');
            } else {
                modal.classList.add('translate-y-full');
            }
        }

        function submitOrder() {
            if (cart.length === 0) return;

            const orderData = {
                table: tableNumber,
                items: cart,
                total: cart.reduce((sum, item) => sum + (item.price * item.qty), 0),
                timestamp: new Date().toLocaleTimeString()
            };

            console.log("بيانات الطلب المرسلة للكاشير:", orderData);

            toggleCart();
            document.getElementById('success-message').innerText = `تم إرسال طلبك للطاولة رقم (${tableNumber}) بنجاح إلى شاشة الكاشير والمطبخ.`;
            document.getElementById('success-alert').classList.remove('hidden');
            
            cart = [];
            updateCartUI();
        }

        function closeSuccess() {
            document.getElementById('success-alert').classList.add('hidden');
        }
    </script>
</body>
</html>
